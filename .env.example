# Copy to `.env` and fill in locally. `.env` is git-ignored: NEVER commit real values.
# Secrets must never go into config/*.yaml, the database, logs or the frontend.

# --- Safety gate --------------------------------------------------------------
# Live trading is not implemented in this build. Even with this set to true the
# engine refuses to start in live mode (see packages/common/safety.py).
LIVE_TRADING_ENABLED=false

# --- Alpaca PAPER trading (Phase 4) -------------------------------------------
# Create PAPER keys in the Alpaca dashboard (paper account), never live keys.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# --- Interactive Brokers PAPER (Phase 8) --------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17

# --- Infrastructure -------------------------------------------------------------
# Local default is SQLite. docker-compose builds a PostgreSQL URL from POSTGRES_PASSWORD.
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=

# --- API (Phase 5) ----------------------------------------------------------------
JEV_API_TOKEN=

# --- Config overrides (optional): JEV__<SECTION>__<KEY>=value ---------------------
# JEV__RISK__MAX_DAILY_LOSS=0.01
